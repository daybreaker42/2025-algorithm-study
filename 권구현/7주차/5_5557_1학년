#include <iostream>
using namespace std;
long long dp[101][21];
int main() {
    int n, a[101];
    cin >> n;
    for (int i = 0; i < n; i++) cin >> a[i];
    dp[0][a[0]] = 1;
    for (int i = 1; i < n - 1; i++) {
        for (int j = 0; j <= 20; j++) {
            if (dp[i-1][j]) {
                if (j + a[i] <= 20) dp[i][j + a[i]] += dp[i-1][j];
                if (j - a[i] >= 0) dp[i][j - a[i]] += dp[i-1][j];
            }
        }
    }
    cout << dp[n-2][a[n-1]];
}
