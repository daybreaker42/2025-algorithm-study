#include <iostream>
#include <stack>

using namespace std;
stack<int> s;
string c;
int x, n;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    cin >> n;
    while(n--) {
        cin >> c;
        if (c == "push") {
            cin >> x;
            s.push(x);
        } else if (c == "pop") {
            if (s.empty()) cout << -1 << '\n';
            else {
                cout << s.top() << '\n';
                s.pop();
            }
        } else if (c == "size") {
            cout << s.size() << '\n';
        } else if (c == "empty") {
            cout << s.empty() << '\n';
        } else {
            if (s.empty()) cout << -1 << '\n';
            else cout << s.top() << '\n';
        }
    }
}
