#include <iostream>
#include <deque>

using namespace std;
int n, k;
deque<int> dq;

int main() {
    cin >> n >> k;
    for (int i = 1; i<n+1; i++) dq.push_back(i);
    
    cout << '<';
    while(dq.size() != 0) {
        for (int i = 0; i<k; i++) {
            if (i == k-1) cout << dq.front();
            else dq.push_back(dq.front());
            dq.pop_front();
        }
        if (dq.size() != 0) cout << ", ";
    }
    cout << '>';
}
