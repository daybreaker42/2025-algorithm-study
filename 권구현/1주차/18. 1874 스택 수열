#include <iostream>
#include <stack>

using namespace std;
int n, x, idx = 1;
stack<int> s;
string ans="";

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    s.push(0);
    cin >> n;
    for (int i = 0; i<n;i++) {
        cin >> x;
        while (idx <= x) {
            s.push(idx++);
            ans += "+\n";
        }
        
        if (s.top() == x) {
            s.pop();
            ans += "-\n";
        } else {
            cout << "NO";
            return 0;
        }
    }
    cout << ans;
    return 0;
}
