#include <iostream>
#include <queue>
#include <map>

using namespace std;
char c;
int t, k, n, cnt, u, d; 
priority_queue<int> upq;
priority_queue<int, vector<int>, greater<int>> dpq;
map<int, int> um, dm;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);

    cin >> t;
    while(t--) {
        upq = {}, dpq = {}, um = {}, dm = {};
        cnt=0;
        cin >> k;
        while(k--) {
            cin >> c >> n;
            if (c=='I') {
                upq.push(n);
                dpq.push(n);
                cnt++;
            } else if (cnt) {
                if (n == -1) {
                    if (dm.find(dpq.top()) == dm.end()) dm[dpq.top()] = 0;
                    dm[dpq.top()]++;
                    dpq.pop();
                } else {
                    if (um.find(upq.top()) == um.end()) um[upq.top()] = 0;
                    um[upq.top()]++;
                    upq.pop();
                }
                while (dm[upq.top()]) {
                    dm[upq.top()]--;
                    upq.pop();
                }
                while (um[dpq.top()]) {
                    um[dpq.top()]--;
                    dpq.pop();
                }
                cnt--;
            }
        }

        if (!cnt) cout << "EMPTY\n";
        else cout << upq.top() << ' ' << dpq.top() << '\n';
    }
}
