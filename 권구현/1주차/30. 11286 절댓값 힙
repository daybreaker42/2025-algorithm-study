#include <iostream>
#include <queue>

using namespace std;
int n, x;
priority_queue<pair<int, bool>> pq;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);

    cin >> n;
    while(n--) {
        cin >> x;
        if (x==0) {
            if (!pq.empty()) {
                if (pq.top().second) cout << pq.top().first << '\n';
                else cout << pq.top().first*-1 << '\n';
                pq.pop();
            } else cout << 0 << '\n';
        } else if (x<0) pq.push({x, true});
        else pq.push({x*-1, false});
    }
}
