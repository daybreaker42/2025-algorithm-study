#include <iostream>

using namespace std;
int n, a, b;

int gcd(int x, int y) {
    return y == 0 ? x : gcd(y, x%y);
}

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    cin >> n;
    while(n--) {
        cin >> a >> b;
        //출력에 유의 범위가 넘어가므로 long long으로 변환해 줘야함.
        cout << (long long)a*b/gcd(a,b) << '\n';
    }
    return 0;
}
