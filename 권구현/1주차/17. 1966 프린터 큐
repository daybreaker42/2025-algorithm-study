#include <iostream>
#include <deque>

using namespace std;
int t, n, m, x, cnt, p[10] = {};
deque<pair<int, int>> dq;

bool isBiggest(int y) {
    for (int i = y+1; i<10; i++) 
        if (p[i] > 0) return false;
    return true;
}

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    cin >> t;
    while (t--) {
        dq = {};
        for(int i = 0; i<10; i++) p[i] = 0;
        cnt = 0;
        
        cin >> n >> m;
        
        for (int i = 0; i<n; i++) {
            cin >> x;
            dq.push_back({x, i});
            p[x]++;
        }
        
        while (!dq.empty()) {
            if (isBiggest(dq.front().first)) {
                if (dq.front().second == m) {
                    cout << cnt+1 << '\n';
                    break;
                } else {
                    p[dq.front().first]--;
                    dq.pop_front();
                    cnt++;
                }
            } else {
                dq.push_back(dq.front());
                dq.pop_front();
            }
        }
    }
}
