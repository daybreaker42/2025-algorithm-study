#include <iostream>
#include <queue>

using namespace std;
int n, x;
priority_queue<int> pq;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);

    cin >> n;
    for (int i = 0; i<n; i++) {
        for (int ii = 0; ii<n; ii++) {
            cin >> x;
            pq.push(-1*x);
            if (pq.size() > n) pq.pop();
        }
    }
    cout << pq.top()*-1;
}
