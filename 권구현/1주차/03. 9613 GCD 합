#include <iostream>

using namespace std;
int t, n, x[100];
long long ans;

int gcd(int a, int b) {
    return b == 0 ? a : gcd(b, a%b);
}

int main() {
    cin >> t;
    while (t--) {
        ans = 0;
        cin >> n;
        for (int i = 0; i<n; i++) cin >> x[i];
        for (int i = 0; i<n; i++) 
            for (int ii = i+1; ii<n; ii++) 
                ans += gcd(x[i], x[ii]);
        cout << ans << '\n';
    }
}

