/*
1. 우선순위 큐는 큰 수부터 pop함.
2. 절대값이 작은 수부터 추출해야하므로 양수인 경우 -1을 곱해줘서 음수로 바꿔 저장
3. 음수값이 크다면 절대값은 작음.
pair함수 써서 양수인 경우는 표기
*/
#include <iostream>
#include <queue>

using namespace std;
int n, x;
priority_queue<pair<int, bool>> pq;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);

    cin >> n;
    while(n--) {
        cin >> x;
        if (x==0) {
            if (!pq.empty()) {
                if (pq.top().second) cout << pq.top().first << '\n';
                else cout << pq.top().first*-1 << '\n';
                pq.pop();
            } else cout << 0 << '\n';
        } else if (x<0) pq.push({x, true});
        else pq.push({x*-1, false});
    }
}
