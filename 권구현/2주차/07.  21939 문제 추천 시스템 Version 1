/*
[방법2]
set과 map을 이용하는 방법
set은 자동적으로 오름차순 정렬이 되는 성질을 이용
set은 erase할때 O(logN)이 소요되지만, [방법 1]은 시간 소요가 거의 없음
=> set 사용하는 방식은 시간이 살짝 느림
*/
#include <iostream>
#include <set>
#include <map>

using namespace std;
int n, p, l;
string s;
set<pair<int, int>> st;
map<int, int> m;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);

    cin >> n;
    while (n--) {
        cin >> p >> l;
        st.insert({l, p});
        m[p] = l;
    }

    cin >> n;
    while(n--) {
        cin >> s;
        if (s == "recommend") {
            cin >> p;
            if (p == 1) cout << st.rbegin()->second << '\n';
            else cout << st.begin()->second << '\n';
        } else if (s == "add") {
            cin >> p >> l;
            st.insert({l, p});
            m[p] = l;
        } else {
            cin >> p;
            st.erase({m[p], p});
        }
    }
}
