/* 
기본적인 set사용법 알려주는 문제
*/
#include <iostream> 
#include <set>

using namespace std;
int n, m, ans=0;
string s;
set<string> st;

int main() {
    cin >> n >> m;
    while (n--) {
        cin >> s;
        st.insert(s);
    }

    while(m--) {
        cin >> s;
        if (st.find(s) != st.end()) ans++;
    }

    cout << ans;
}
