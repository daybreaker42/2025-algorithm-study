#include <iostream>
using namespace std;

int psum[1025][1025];

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);

    int n, m, x1, y1, x2, y2;
    cin >> n >> m;

    for (int i=1; i<=n; i++)
        for (int j=1; j<=n; j++) {
            int val;
            cin >> val;
            psum[i][j] = psum[i-1][j] + psum[i][j-1] - psum[i-1][j-1] + val;
        }

    while (m--) {
        cin >> x1 >> y1 >> x2 >> y2;
        cout << psum[x2][y2] - psum[x1-1][y2] - psum[x2][y1-1] + psum[x1-1][y1-1] << '\n';
    }
}
