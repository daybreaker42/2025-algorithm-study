#include <iostream>
#include <vector>
#include <queue>
#include <algorithm>
using namespace std;
int N;
vector<string> A;
vector<vector<bool>> vis;
int dr[4]={-1,1,0,0}, dc[4]={0,0,-1,1};
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cin>>N;
    A.resize(N);
    for(int i=0;i<N;i++) cin>>A[i];
    vis.assign(N, vector<bool>(N,false));
    vector<int> comps;
    for(int i=0;i<N;i++){
        for(int j=0;j<N;j++){
            if(A[i][j]=='1' && !vis[i][j]){
                int cnt=0;
                queue<pair<int,int>> q;
                q.push({i,j}); vis[i][j]=true;
                while(!q.empty()){
                    auto [r,c]=q.front(); q.pop();
                    cnt++;
                    for(int d=0;d<4;d++){
                        int nr=r+dr[d], nc=c+dc[d];
                        if(nr<0||nr>=N||nc<0||nc>=N) continue;
                        if(A[nr][nc]=='1' && !vis[nr][nc]){
                            vis[nr][nc]=true;
                            q.push({nr,nc});
                        }
                    }
                }
                comps.push_back(cnt);
            }
        }
    }
    sort(comps.begin(), comps.end());
    cout<<comps.size()<<"\n";
    for(int x:comps) cout<<x<<"\n";
    return 0;
}
